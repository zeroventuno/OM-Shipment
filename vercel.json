{
    "rewrites": [
        {
            "source": "/((?!assets/|og-|favicon|logo|apple-touch-icon).*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/og-(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
        }
    ]
}
