{
    "rewrites": [
        {
            "source": "/t/:code",
            "destination": "/tag.html"
        },
        {
            "source": "/assistenza/:token",
            "destination": "/assistenza.html"
        },
        {
            "source": "/ritiro/:token",
            "destination": "/ritiro.html"
        },
        {
            "source": "/ferie/:token",
            "destination": "/ferie.html"
        },
        {
            "source": "/((?!api/|assets/|og-|favicon|logo|apple-touch-icon).*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/og-(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400"
                }
            ]
        }
    ]
}
