# Supabase — obrigatório. Sem estas duas variáveis o app roda em LocalStorage
# e SEM login; use apenas para teste local, nunca em produção.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# 17TRACK — opcional. Sem a chave o rastreio usa dados simulados.
VITE_17TRACK_KEY=sua_chave_aqui
