# --- App (vai para o navegador; precisa estar também na Vercel) -------------
# Projeto Supabase ÚNICO do sistema (o antigo projeto do OM-Shipment).
# Sem estas duas variáveis não há login: use só para teste local.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# 17TRACK — opcional. Sem a chave o rastreio dos envios usa dados simulados.
VITE_17TRACK_KEY=sua_chave_aqui

# --- Só para a cópia única dos dados do OM-Assist (npm run migrate:assist) ----
# Nunca coloque estas na Vercel. Apague depois da migração.
ASSIST_DATABASE_URL=postgresql://...banco-antigo-do-om-assist...
TARGET_SUPABASE_URL=https://seu-projeto.supabase.co
TARGET_SUPABASE_SERVICE_ROLE_KEY=chave_service_role_do_projeto
